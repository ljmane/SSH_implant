#Implant script variables defined. Depending on persistence script may or may not have all the variables listed here
REMLIS=<RHP> - This is the port that will be listening on your attack hosts, you will ssh to this port on localhost
REMUSR=user - This the chroot user on your attack host
TARUSR=<target_user> - This is the target user that has the ssh key
TARSSH=<target_ssh_port> - This is the ssh port the target server is listening on
CHK_IPs="<CHK_IPs>" - This is the public IP address(es) or hostname(s) that the implant will be checking \for the $CHK_PORT. Space-separated if multiple.
CHK_PORT=<CHK_PORT> - This is the port that implant will checking if open, if open then ssh connection will be initiated.
CB_IP / CB_PORT - Not script variables — these come from the beacon response itself
	(the info.sh "<CB_PORT>:<CB_IP>:<REMLIS>" line in Access), one value per check-in,
	not a locally-configured list. CB_IP may be an IP address or a hostname; it's
	passed straight to ssh, which resolves it natively.
KEY="<location_to_key>" - This is the location of the private key on the target.
SLEEP=<time_in_seconds> - Analyst will have this much time to connect and kill the script so they don\'t get disconnected.
SLEEP1=<time_in_seconds_that_REMLIS_will_be_available> #Non-Persistent only
SLEEP2=<time_in_seconds_between_checks> #Non-Persistent only
